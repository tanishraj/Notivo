{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nmc-notice-monitor",
  "main": "src/index.ts",
  "build": { "command": "npm run build:portal", "watch_dir": "portal/src" },
  "assets": { "directory": "./portal/dist", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "EMAIL_ENABLED": "false",
    "RECENT_PAGES": "3",
    "BASELINE_PAGES_PER_RUN": "3",
    "AUDIT_PAGES_PER_RUN": "2",
    "EMAILS_PER_RUN": "5"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nmc-notices",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
