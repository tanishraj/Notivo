{
  "name": "notivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/prepare-local-secrets.mjs",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply nmc-notices --local",
    "db:migrate:remote": "wrangler d1 migrations apply nmc-notices --remote",
    "db:migrate:production": "wrangler d1 migrations apply nmc-notices --remote --env production",
    "typecheck": "tsc --noEmit && tsc -p portal/tsconfig.json",
    "build:portal": "vite build --config portal/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "admin": "node scripts/admin.mjs",
    "email:preview": "node scripts/admin.mjs preview --html",
    "email:preview:grouped": "node scripts/grouped-email-preview.mjs"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "entities": "^8.1.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
